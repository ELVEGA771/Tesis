  <data key="d0">Class</data>
  <data key="d2">True</data>
  <data key="d1">Una por cada documento que afirma la relacion. Si los dos ADR la declaran, hay dos.</data>
</node>
<node id="Repository">
  <data key="d0">Class</data>
</node>
<node id="StatusDeclaration">
  <data key="d0">Class</data>
