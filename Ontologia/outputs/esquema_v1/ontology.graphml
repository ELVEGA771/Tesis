  <data key="d3">["Functional"]</data>
  <data key="d1">Si la opcion elegida no figura entre las listadas, se crea como Alternative con la frase de la eleccion como evidencia.</data>
</node>
<node id="sourceADR">
  <data key="d0">ObjectProperty</data>
  <data key="d1">Va desde el ADR NUEVO (el que reemplaza o enmienda) hacia la declaracion.</data>
</node>
<node id="targetADR">
  <data key="d0">ObjectProperty</data>
  <data key="d1">Va desde el ADR AFECTADO (el reemplazado o enmendado) hacia la declaracion.</data>
</node>
