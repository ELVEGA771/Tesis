</node>
<node id="reltype_supersedes">
  <data key="d0">RelationType</data>
  <data key="d1">El ADR origen deja sin vigencia al ADR destino (superseded by / supersedes / replaces).</data>
</node>
<node id="reltype_amends">
  <data key="d0">RelationType</data>
  <data key="d1">El ADR origen modifica al ADR destino, que sigue vigente (amends / amended by).</data>
</node>
